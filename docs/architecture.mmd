flowchart LR
    %% ===== inputs =====
    prot(["Protein<br/>sequences"]):::inp
    dna(["DNA probes<br/>36 bp"]):::inp
    aff(["Affinity<br/>N × P"]):::inp

    %% ===== protein tower =====
    dbd["DBD trim<br/><i>optional</i>"]:::opt
    esm[["Frozen ESM-2<br/>(cached)"]]:::frozen
    ptok("Protein tower<br/><b>K specificity tokens</b>"):::ptow

    %% ===== DNA tower =====
    onehot["one-hot"]:::dnastep
    dtow("DNA tower · CNN<br/><b>per-position map</b>"):::dtow

    %% ===== fusion + train =====
    xattn{{"Cross-attention<br/>tokens scan positions"}}:::fuse
    tgt["Target z-score<br/>per protein"]:::data
    train("Train + evaluate<br/>leave-proteins-out CV"):::train

    %% ---- protein lane ----
    prot --> dbd --> esm --> ptok --> xattn
    %% ---- dna lane ----
    dna --> onehot --> dtow --> xattn
    %% ---- fuse + train ----
    xattn ==> train
    aff --> tgt -. target .-> train

